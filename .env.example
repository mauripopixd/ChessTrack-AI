# Copia este archivo a .env (que git ignora) y ajusta si hace falta.
# Valores por defecto: el PostgreSQL de docker-compose.yml.
DATABASE_URL=postgresql+psycopg://chesstrack:chesstrack@127.0.0.1:5433/chesstrack
TEST_DATABASE_URL=postgresql+psycopg://chesstrack:chesstrack@127.0.0.1:5433/chesstrack_test

# Clave para firmar los JWT (mínimo 32 caracteres). Genera una propia con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
