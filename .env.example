# Copia este archivo a .env (que git ignora) y ajusta si hace falta.
# Valores por defecto: el PostgreSQL de docker-compose.yml.
DATABASE_URL=postgresql+psycopg://chesstrack:chesstrack@127.0.0.1:5433/chesstrack
TEST_DATABASE_URL=postgresql+psycopg://chesstrack:chesstrack@127.0.0.1:5433/chesstrack_test

# Clave para firmar los JWT (mínimo 32 caracteres). Genera una propia con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60

# RAG de aperturas (POST /openings/ask): LLM gratuito.
# Groq: clave gratis y sin tarjeta en console.groq.com (plan gratuito: ~8.000 tokens/minuto
# con gpt-oss-120b). Si no hay clave o se agota el límite, se usa Ollama local.
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# OLLAMA_MODEL=qwen3.5:9b-q4_K_M     (vacío = sin respaldo local)
# OLLAMA_URL=http://127.0.0.1:11434/v1
